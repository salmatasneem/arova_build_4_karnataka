        "explanation": { "type": "string", "minLength": 1, "maxLength": 800 },
        "triggeredMetrics": { "type": "array" },
        "source": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware", "webcam_pose", "demo_simulation"] },
        "fallEventId": { "type": "string", "maxLength": 128 },
        "sensorFusionStatus": { "type": "string", "enum": ["webcam_only", "corroborated", "sensor_disagreement"] },
        "acknowledgedByUid": { "type": "string", "maxLength": 128 },
        "acknowledgedByName": { "type": "string", "maxLength": 100 },
        "followUpAction": { "type": "string", "maxLength": 500 },
        "anomalyScore": { "type": "number" },
        "prototypeNotice": { "type": "string", "maxLength": 240 },
        "relevantReadingsSummary": { "type": "string", "maxLength": 240 },
        "patientAcknowledged": { "type": "boolean" },
        "falseAlertReported": { "type": "boolean" },
        "falseAlertReason": { "type": "string", "maxLength": 300 },
        "unreadByPatient": { "type": "boolean" },
        "unreadByCaregiver": { "type": "boolean" },
        "notificationStatus": { "type": "string", "enum": ["pending", "simulated", "delivered", "partial_failure", "failed"] },
        "escalationStatus": { "type": "string", "maxLength": 64 },
        "callEscalationStatus": {
          "type": "string",
          "enum": ["not_triggered", "provider_unconfigured", "calling_primary", "primary_answered", "escalated_secondary", "completed"]
        },
        "callLog": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "alertId",
        "patientId",
        "ownerUid",
        "level",
        "status",
        "title",
        "explanation",
        "triggeredMetrics",
        "source",
        "callEscalationStatus",
        "callLog",
        "createdAt",
        "updatedAt"
      ]
    },
