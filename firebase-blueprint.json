{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-sensitive user profile, settings, and RBAC role assignment for AROVA.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["patient", "caregiver", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "profileSettings": { "type": "object", "description": "User monitoring and notification preferences." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII contact details for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "emergencyNotes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "PatientRecord": {
      "title": "PatientRecord",
      "description": "Patient monitoring profile, personal baseline metrics, and caregiver assignments.",
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ageGroup": { "type": "string", "maxLength": 40 },
        "baselineStatus": { "type": "string", "enum": ["not_started", "collecting", "ready"] },
        "baselineSamplesCount": { "type": "integer" },
        "baselineHeartRateMean": { "type": "number" },
        "baselineSpo2Mean": { "type": "number" },
        "baselineTempMean": { "type": "number" },
        "baselineSource": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware"] },
        "baselineModelTrained": { "type": "boolean" },
        "baselineModelVersion": { "type": "string", "maxLength": 80 },
        "baselineEcgBpmMean": { "type": "number" },
        "baselineActiveHrMean": { "type": "number" },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
