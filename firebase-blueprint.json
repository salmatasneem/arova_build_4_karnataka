        "alertSeverity",
        "reasonForCalling",
        "relevantReading",
        "caregiverName",
        "caregiverPriority",
        "maskedPhone",
        "callStatus",
        "selectedLanguage",
        "caregiverResponse",
        "durationSec",
        "retryCount",
        "escalationStatus",
        "followUpAction",
        "isTestCall",
        "startedAt",
        "createdAt",
        "updatedAt"
      ]
