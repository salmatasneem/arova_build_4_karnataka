        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "patientId",
        "ownerUid",
        "displayName",
        "baselineStatus",
        "baselineSamplesCount",
        "dataMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "VitalReading": {
      "title": "VitalReading",
      "description": "Immutable vital-sign, motion, and ECG waveform telemetry record from wearable or simulator.",
      "type": "object",
      "properties": {
        "readingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceId": { "type": "string", "maxLength": 128 },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "heartRate": { "type": ["number", "null"] },
        "spo2": { "type": ["number", "null"] },
        "temperatureC": { "type": ["number", "null"] },
        "movementStatus": { "type": "string", "enum": ["resting", "walking", "active", "fall_suspect", "inactive"] },
        "accelMagnitude": { "type": "number" },
        "gyroMagnitude": { "type": "number" },
        "accelX": { "type": ["number", "null"] },
        "accelY": { "type": ["number", "null"] },
        "accelZ": { "type": ["number", "null"] },
        "gyroX": { "type": ["number", "null"] },
        "gyroY": { "type": ["number", "null"] },
        "gyroZ": { "type": ["number", "null"] },
        "possibleFallDetected": { "type": "boolean" },
        "ecgSamples": { "type": "array" },
        "ecgSamplingRate": { "type": "number" },
        "ecgSignalQuality": { "type": "string", "enum": ["good", "noisy", "lead_off", "unavailable"] },
        "ecgLeadOff": { "type": "boolean" },
        "ecgTimestamp": { "type": "string", "maxLength": 60 },
        "ecgHeartRateBpm": { "type": "number" },
        "signalQuality": { "type": "string", "enum": ["good", "noisy", "poor_contact"] },
        "anomalyStatus": { "type": "string", "enum": ["insufficient_baseline", "paused_poor_quality", "normal", "anomalous"] },
        "anomalyScore": { "type": "number" },
        "alertLevel": { "type": "string", "enum": ["Normal", "Warning", "Critical"] },
        "contributingFeatures": { "type": "array" },
        "persistenceCount": { "type": "integer" },
        "modelVersion": { "type": "string", "maxLength": 80 },
        "source": { "type": "string", "enum": ["sample_demo", "simulator", "esp32_hardware"] },
        "mlEngine": { "type": "string", "enum": ["unconnected_rule_check", "python_isolation_forest"] },
        "explanation": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "readingId",
        "patientId",
        "ownerUid",
        "heartRate",
        "spo2",
        "temperatureC",
        "movementStatus",
        "signalQuality",
        "anomalyScore",
        "alertLevel",
        "source",
        "mlEngine",
        "explanation",
        "createdAt"
      ]
    },
    "AlertRecord": {
      "title": "AlertRecord",
      "description": "Early warning alert, caregiver acknowledgement, and escalation call log.",
      "type": "object",
      "properties": {
        "alertId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "primaryCaregiverUid": { "type": "string", "maxLength": 128 },
        "secondaryCaregiverUid": { "type": "string", "maxLength": 128 },
