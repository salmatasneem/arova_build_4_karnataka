  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Administrator authorization lookup collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public/non-PII user profiles and role assignment."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateContact" },
      "description": "Isolated PII contact information readable only by owner or admin."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientRecord" },
      "description": "Monitored patient records, baselines, and assigned caregiver references."
    },
    "/patients/{patientId}/readings/{readingId}": {
      "schema": { "$ref": "#/entities/VitalReading" },
      "description": "Wearable vital readings subcollection scoped to patient and linked caregivers."
    },
    "/patients/{patientId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertRecord" },
      "description": "Alerts and caregiver escalation workflow logs scoped to patient and caregivers."
    },
    "/patients/{patientId}/fallEvents/{eventId}": {
      "schema": { "$ref": "#/entities/FallDetectionEvent" },
      "description": "Camera-based pose fall detection events and confirmation history scoped to patient and authorized caregivers."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/WearableDevice" },
      "description": "Registered ESP32 wearable hardware units."
    },
    "/careLinks/{linkId}": {
      "schema": { "$ref": "#/entities/CareLink" },
      "description": "Patient-caregiver monitoring and escalation relationships."
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global application thresholds, retry policies, and escalation timeouts."
    },
    "/caregiverContacts/{contactId}": {
      "schema": { "$ref": "#/entities/CaregiverVoiceContact" },
      "description": "Registered caregiver voice contact preferences, consent, and PHI authorization."
    },
    "/voiceCallHistory/{callId}": {
      "schema": { "$ref": "#/entities/VoiceCallRecord" },
      "description": "Arova AI outbound call history and structured caregiver response records."
    },
    "/voiceEscalations/{escalationId}": {
      "schema": { "$ref": "#/entities/VoiceEscalationEvent" },
      "description": "Active and historical emergency escalation workflows."
    },
    "/voiceAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/VoiceAuditLog" },
      "description": "Immutable voice calling and escalation audit trail."
    },
    "/baselines/{baselineId}": {
      "schema": { "$ref": "#/entities/BaselineRecord" },
      "description": "Personalized vital baseline statistics and learning status per patient and source."
    },
    "/anomaly_events/{eventId}": {
      "schema": { "$ref": "#/entities/AnomalyEventRecord" },
      "description": "Immutable anomaly detection events linked to patient monitoring profiles."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/SystemAuditLog" },
      "description": "Immutable authentication, RBAC, device, and alert activity audit logs."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/InAppNotification" },
      "description": "Patient and authorized caregiver in-app prototype alert notifications."
    }
  }
}
