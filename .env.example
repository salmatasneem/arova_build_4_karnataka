# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ML_SERVICE_URL: Optional URL for the Python FastAPI Isolation Forest service (e.g., http://127.0.0.1:18000; avoid 8000 in AI Studio).
# When unset or unreachable, the backend runs in clearly labelled Demo Mode.
ML_SERVICE_URL=""

# Twilio Programmable Voice & SMS (Server-Side Only — never expose in VITE_* variables)
# TWILIO_ACCOUNT_SID: Your Twilio Account SID (starts with AC...)
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token (used for REST calls and webhook X-Twilio-Signature verification)
# TWILIO_PHONE_NUMBER: Your Twilio voice/SMS-capable phone number in E.164 format (e.g. +14155550100)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel SMS / Voice (Optional Server-Side Only; falls back to Simulation Mode when unset)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# Email Notifications (Optional Server-Side Only: Resend OR Custom HTTPS Webhook Relay)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_API_KEY=

# Firebase Configuration (Optional overrides; AI Studio provisions firebase-applet-config.json automatically)
# FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_DATABASE_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
